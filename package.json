{
  "name": "cleanbox",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "prepare": "husky",
    "lint:backend": "cd backend && npm run lint",
    "lint:frontend": "cd frontend && npm run lint",
    "typecheck:backend": "cd backend && npm run typecheck",
    "format:backend": "cd backend && npm run format",
    "format:frontend": "cd frontend && npm run format",
    "test:backend": "cd backend && npm run test"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "bash -c 'cd backend && npx eslint --fix $0'",
      "bash -c 'cd backend && npx prettier --write $0'"
    ],
    "frontend/src/**/*.{ts,tsx}": [
      "bash -c 'cd frontend && npx eslint --fix $0'",
      "bash -c 'cd frontend && npx prettier --write $0'"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
